# Required: choose your own database password.
# For an external database, use its existing password.
POSTGRES_PASSWORD=''

# Required: choose your administrator password (12-128 characters,
# uppercase and lowercase letters, a number and a symbol).
ADMIN_PASSWORD=''

# Optional: the web UI is available at http://127.0.0.1:8080.
ADMIN_USERNAME=admin
BIND_ADDRESS=127.0.0.1
PORT=8080

# Database: local starts bundled PostgreSQL; external uses your server.
DATABASE_MODE=local
# Keep this line: Compose enables the local database only in local mode.
COMPOSE_PROFILES=${DATABASE_MODE}

# Database settings: host, port and TLS apply only to external mode.
# User and database name also configure a new bundled database.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=relayix
POSTGRES_DB=relayix
POSTGRES_SSLMODE=verify-full

# Optional: path to your PostgreSQL CA certificate on the Docker host.
# Leave empty for the default trusted CA certificates; use e.g. /srv/relayix/postgres-ca.crt.
POSTGRES_CA_PATH=

# Optional: set true when serving the UI behind HTTPS.
COOKIE_SECURE=false

# Optional: credentials for Telegram MTProto / WEB proxies only.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: explicitly trusted internal destinations/proxies, comma-separated IPs/CIDRs.
# Empty blocks private, loopback, link-local and other special-use addresses.
# Example for an internal Gotify server: OUTBOUND_ALLOWLIST=192.168.10.5/32
OUTBOUND_ALLOWLIST=

# Parallel notification deliveries (1-32). Telegram processes have a separate cap of 4.
DELIVERY_WORKERS=4
# Delete completed event/delivery/alert history after this many days; 0 keeps it forever.
EVENT_RETENTION_DAYS=30

# Reverse proxy IPs/CIDRs permitted to supply X-Forwarded-For; empty ignores it.
# For host Caddy through Docker, use the actual bridge gateway IP (see deployment guide).
# Trust only proxy addresses; do not trust all clients or all Docker containers.
TRUSTED_PROXIES=
